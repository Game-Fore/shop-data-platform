# Шаблон переменных окружения. Скопируйте в .env и задайте свои пароли:
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
# .env в git не попадает (см. .gitignore).
# Имена баз (shop) не параметризуются: они зашиты в SQL-схемы и топики Debezium.

# PostgreSQL (источник). Пароль применяется только при первой инициализации,
# поэтому после смены пароля нужен полный сброс: .\reset.ps1
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me-pg

# ClickHouse (приёмник)
CLICKHOUSE_USER=shop
CLICKHOUSE_PASSWORD=change-me-ch

# BI (профиль bi, этап 3). Нужны только для docker compose --profile bi.
# Ключ шифрования Superset: python -c "import secrets; print(secrets.token_urlsafe(42))"
SUPERSET_SECRET_KEY=change-me-long-random-string
SUPERSET_ADMIN_PASSWORD=change-me-admin
SUPERSET_DB_PASSWORD=change-me-superset-db
CLICKHOUSE_BI_PASSWORD=change-me-bi
